<Window x:Class="Task2.Views.EmployeeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:res="clr-namespace:Task2.Properties"
        xmlns:local="clr-namespace:Task2.Views" xmlns:viewmodels="clr-namespace:Task2.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:EmployeeDialogViewModel}"
        mc:Ignorable="d"
        Title="EmployeeDialog" Height="330" Width="530">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="Red"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="ToolTip"
                    Value="{Binding RelativeSource={RelativeSource Self},
                            Path=(Validation.Errors)[0].ErrorContent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Employee Form">
            <Grid Height="200">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Label Content="Full Name" HorizontalAlignment="Left" 
                            VerticalContentAlignment="Center" Grid.Column="0" Grid.Row="0"/>
                <TextBox Grid.Row="0" Grid.Column="1" Height="27" 
                            Text="{Binding Path=Employee.FullName, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"  Margin="5"  Width="300" HorizontalAlignment="Left"/>

                <Label Content="Age" HorizontalAlignment="Left" VerticalContentAlignment="Center" 
                            Grid.Row="1" Grid.Column="0"/>
                <TextBox Grid.Row="1" Grid.Column="1" Height="27" 
                            Text="{Binding Path=Employee.Age, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" Margin="5" Width="110" HorizontalAlignment="Left"/>

                <Label Content="Married" HorizontalAlignment="Left" VerticalContentAlignment="Center" 
                            Grid.Row="2" Grid.Column="0"/>
                <CheckBox Grid.Row="2" Grid.Column="1" Height="27" 
                            IsChecked="{Binding Path=Employee.IsMarried, Mode=TwoWay}" Margin="5" HorizontalAlignment="Left"/>

                <Label Content="Salary" HorizontalAlignment="Left" VerticalContentAlignment="Center" 
                            Grid.Row="3" Grid.Column="0"/>
                <TextBox Grid.Row="3" Grid.Column="1" Height="27" 
                            Text="{Binding Path=Employee.Salary, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" Margin="5" Width="110" HorizontalAlignment="Left"/>

                <Label Content="Position" HorizontalAlignment="Left" VerticalContentAlignment="Center" 
                            Grid.Row="4" Grid.Column="0"/>
                <ComboBox Grid.Row="4" Grid.Column="1" Height="27"
                            ItemsSource="{Binding Positions}"
                            SelectedItem="{Binding Employee.Position, Mode=TwoWay}"
                            Margin="5" Width="110" HorizontalAlignment="Left"/>

                <Label Content="Hire Date" HorizontalAlignment="Left" VerticalContentAlignment="Center" 
                            Grid.Row="5" Grid.Column="0"/>
                <DatePicker Grid.Row="5" Grid.Column="1" Height="27" 
                            Text="{Binding Path=Employee.HireDate, Mode=TwoWay}" Margin="5" Width="110" HorizontalAlignment="Left"/>
            </Grid>
        </GroupBox>
        <Grid Grid.Row="1">
            <Button HorizontalAlignment="Left" Content="{x:Static res:Resources.Button_Confirm}" Command="{Binding OkCommand}"/>
            <Button HorizontalAlignment="Right" Content="{x:Static res:Resources.Button_Cancel}" Command="{Binding CancelCommand}" />
        </Grid>
    </Grid>
</Window>

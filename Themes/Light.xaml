<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Brush.Background.Primary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Background.Secondary" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Border" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="Brush.Border.Focused" Color="#3B82F6"/>
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#6B6B6B"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="#3B82F6"/>
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#2563EB"/>
    <SolidColorBrush x:Key="Brush.Error" Color="#DC2626"/>
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="Brush.Disabled.Background" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="Brush.Disabled.Foreground" Color="#A0A0A0"/>
</ResourceDictionary>
    <SolidColorBrush x:Key="Brush.Background.Primary" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Brush.Background.Secondary" Color="#252526"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="#2D2D30"/>
    <SolidColorBrush x:Key="Brush.Border" Color="#3F3F46"/>
    <SolidColorBrush x:Key="Brush.Border.Focused" Color="#569CD6"/>
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#E0E0E0"/>
